# Salin file ini jadi .env dan isi sesuai environment kamu.

SECRET_KEY=ganti-dengan-secret-key-acak
JWT_SECRET_KEY=ganti-dengan-jwt-secret-acak

DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=2amstage

# --- Email (Brevo SMTP relay - gratis 300 email/hari) ---
# 1. Daftar gratis di https://www.brevo.com
# 2. Buka menu "SMTP & API" -> tab "SMTP" -> catat Login & bikin "Generate a new SMTP key"
# 3. Verifikasi 1 email pengirim di menu "Senders, Domains & Dedicated IPs" -> Senders
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=isi-login-smtp-brevo-kamu
MAIL_PASSWORD=isi-smtp-key-brevo-kamu
MAIL_DEFAULT_SENDER=email-pengirim-yang-sudah-diverifikasi@example.com
